# Application Configuration
APP_NAME="RAG-Based Hallucination Detection System"
APP_ENV=development
API_V1_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# Security / JWT
SECRET_KEY=rag-hallucination-secret-key-change-in-production-2026-secure-random-seed
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./rag_hallucination.db
# For PostgreSQL later:
# DATABASE_URL=postgresql://user:password@localhost:5432/rag_hallucination_db

# File Storage
UPLOAD_DIR=../data/documents
VECTOR_DB_DIR=../data/vectors
MAX_UPLOAD_SIZE_MB=25

# RAG & LLM Configuration
DEFAULT_TOP_K=4
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_TEMPERATURE=0.2
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_PROVIDER=extractive-grounded
# LLM_PROVIDER options: 'extractive-grounded' (built-in reliable zero-cost RAG generator), 'gemini', 'openai'
GEMINI_API_KEY=
OPENAI_API_KEY=

# ML Hallucination Model
ML_MODEL_PATH=../training/model/classifier.joblib
